        +setUnlockData(unlockData: string) -> LegacySamSelectionExtension
        +setUnlockData(unlockData: string, productType: LegacySam.ProductType) -> LegacySamSelectionExtension
        +setStaticUnlockDataProvider(staticUnlockDataProvider: LegacySamStaticUnlockDataProviderSpi) -> LegacySamSelectionExtension
        +setStaticUnlockDataProvider(staticUnlockDataProvider: LegacySamStaticUnlockDataProviderSpi, targetSamReader: CardReader) -> LegacySamSelectionExtension
        +setDynamicUnlockDataProvider(dynamicUnlockDataProvider: LegacySamDynamicUnlockDataProviderSpi) -> LegacySamSelectionExtension
        +setDynamicUnlockDataProvider(dynamicUnlockDataProvider: LegacySamDynamicUnlockDataProviderSpi, targetSamReader: CardReader) -> LegacySamSelectionExtension

        +prepareReadSamParameters() -> LegacySamSelectionExtension

        +<color:grey>prepareReadCaadRecord(caadRecordNumber: integer) -> LegacySamSelectionExtension
        +<color:grey>prepareReadCaadRecords(fromCaadRecordNumber: integer, toCaadRecordNumber: integer) -> LegacySamSelectionExtension

        +prepareReadSystemKeyParameters(systemKeyType: SystemKeyType) -> LegacySamSelectionExtension

        +prepareReadWorkKeyParameters(recordNumber: integer) -> LegacySamSelectionExtension
        +prepareReadWorkKeyParameters(kif: byte, kvc: byte) -> LegacySamSelectionExtension

        +prepareReadCounterStatus(counterNumber: integer) -> LegacySamSelectionExtension
        +prepareReadAllCountersStatus() -> LegacySamSelectionExtension

        +prepareGetData(tag: GetDataTag) -> LegacySamSelectionExtension
    }
    +interface "<<<back:yellow>SmartCard</back>>>\nLegacySam" as LegacySam {
        +getProductType() -> ProductType
        +getProductInfo() -> string

        +getSerialNumber() -> byte array
