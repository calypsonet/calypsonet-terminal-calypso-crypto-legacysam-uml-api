package "calypso.crypto.legacysam" as legacysam {

+class "**final** LegacySamApiProperties" as ApiProperties <<green>> {
    +{static} **final** VERSION: string
}
+interface "LegacySamApiFactory" as LegacySamApiFactory <<blue>> {

    +createLegacySamSelectionExtension() -> LegacySamSelectionExtension

    +createSymmetricCryptoCardTransactionManagerFactory(samReader: <back:yellow>CardReader</back>, sam: LegacySam) -> <back:pink>SymmetricCryptoCardTransactionManagerFactory</back>

    +createSecuritySetting() -> SecuritySetting

    +createFreeTransactionManager(samReader: <back:yellow>CardReader</back>, sam: LegacySam) -> FreeTransactionManager
    +<color:grey>createSecureReadTransactionManager(samReader: <back:yellow>CardReader</back>, sam: LegacySam, securitySetting: SecuritySetting) -> SecureReadTransactionManager
    +createSecureWriteTransactionManager(samReader: <back:yellow>CardReader</back>, sam: LegacySam, securitySetting: SecuritySetting) -> SecureWriteTransactionManager
    +createAsyncTransactionCreatorManager(targetSamContext: string, securitySetting: SecuritySetting) -> AsyncTransactionCreatorManager
    +createAsyncTransactionExecutorManager(samReader: <back:yellow>CardReader</back>, sam: LegacySam, samCommands: string) -> AsyncTransactionExecutorManager

    +createKeyPairContainer() -> KeyPairContainer
    +createLegacyCardCertificateComputationData() -> LegacyCardCertificateComputationData

    +createBasicSignatureComputationData() -> BasicSignatureComputationData
    +createTraceableSignatureComputationData() -> TraceableSignatureComputationData
    +createBasicSignatureVerificationData() -> BasicSignatureVerificationData
    +createTraceableSignatureVerificationData() -> TraceableSignatureVerificationData
}
+enum SystemKeyType <<green>> {
    PERSONALIZATION
    KEY_MANAGEMENT
    RELOADING
    AUTHENTICATION
}
+enum "GetDataTag" as GetDataTag <<green>> {
    CA_CERTIFICATE
}
+enum "CounterIncrementAccess" as CounterIncrementAccess <<green>> {
    FREE_COUNTING_ENABLED
    FREE_COUNTING_DISABLED
}

package "transaction" as transaction {
    +interface "<<<back:yellow>CardTransactionManager</back>>></color>\nTransactionManager" as TransactionManager <<grey>> {
    }
    +interface ReadTransactionManager<T : ReadTransactionManager<T>> <<grey>> extends TransactionManager {
        +prepareReadSamParameters() -> T

        +<color:grey>prepareReadCaadRecord(caadRecordNumber: integer) -> T
        +<color:grey>prepareReadCaadRecords(fromCaadRecordNumber: integer, toCaadRecordNumber: integer) -> T

        +prepareReadSystemKeyParameters(systemKeyType: SystemKeyType) -> T

        +prepareReadWorkKeyParameters(recordNumber: integer) -> T
        +prepareReadWorkKeyParameters(kif: byte, kvc: byte) -> T

        +prepareReadCounterStatus(counterNumber: integer) -> T
        +prepareReadAllCountersStatus() -> T
    }
    +interface WriteTransactionManager<T : WriteTransactionManager<T>> <<grey>> extends TransactionManager {
        +prepareWriteCounterCeiling(counterNumber: integer, ceilingValue: integer) -> T
        +prepareWriteCounterConfiguration(counterNumber: integer, ceilingValue: integer, counterIncrementAccess: CounterIncrementAccess) -> T
    }
    +interface "<color:grey>SecureReadTransactionManager" as SecureReadTransactionManager <<blue>> extends ReadTransactionManager {
    }
    +interface FreeTransactionManager <<blue>> extends ReadTransactionManager {
        +prepareGetData(tag: GetDataTag) -> FreeTransactionManager
        +prepareGenerateCardAsymmetricKeyPair(keyPairContainer: KeyPairContainer) -> FreeTransactionManager
        +prepareComputeCardCertificate(data: LegacyCardCertificateComputationData) -> FreeTransactionManager

        +<color:grey>preparePlainLoadWorkKey(kif: byte, kvc: byte, workKeyParameters: byte array, workKeyValue: byte array) -> FreeTransactionManager
        +<color:grey>preparePlainExportWorkKey(kif: byte, kvc: byte, workKeyParameters: byte array, workKeyValue: byte array) -> FreeTransactionManager

        +preparePlainWriteLock(lockIndex: byte, lockParameters: byte, lockValue: byte array) -> FreeTransactionManager

        +prepareComputeSignature(data: SignatureComputationData<?>) -> FreeTransactionManager
        +prepareVerifySignature(data: SignatureVerificationData<?>) -> FreeTransactionManager

        +exportTargetSamContextForAsyncTransaction() -> string
    }
    +interface "SecureWriteTransactionManager" as SecureWriteTransactionManager <<blue>> extends WriteTransactionManager {
        +prepareWriteSamParameters(parameters: byte array) -> SecureWriteTransactionManager

        +<color:grey>prepareWriteCaadRecord(caadRecordNumber: integer, caad: byte array) -> SecureWriteTransactionManager

        +prepareTransferSystemKey(systemKeyType: SystemKeyType, kvc: byte, systemKeyParameters: byte array) -> SecureWriteTransactionManager
        +prepareTransferSystemKeyDiversified(systemKeyType: SystemKeyType, kvc: byte, systemKeyParameters: byte array) -> SecureWriteTransactionManager

        +prepareTransferWorkKey(kif: byte, kvc: byte, workKeyParameters: byte array, targetRecordNumber: integer) -> SecureWriteTransactionManager
        +prepareTransferWorkKeyDiversified(kif: byte, kvc: byte, workKeyParameters: byte array, targetRecordNumber: integer) -> SecureWriteTransactionManager
        +prepareTransferWorkKeyDiversified(kif: byte, kvc: byte, workKeyParameters: byte array, targetRecordNumber: integer, diversifier: byte array) -> SecureWriteTransactionManager

        +prepareTransferLock(lockIndex: byte, lockParameters: byte) -> SecureWriteTransactionManager
        +prepareTransferLockDiversified(lockIndex: byte, lockParameters: byte) -> SecureWriteTransactionManager

        +preparePlainWriteLock(lockIndex: byte, lockParameters: byte, lockValue: byte array) -> SecureWriteTransactionManager
    }
    +interface AsyncTransactionCreatorManager <<blue>> extends WriteTransactionManager {
        +exportCommands() -> string
    }
    +interface AsyncTransactionExecutorManager <<blue>> extends TransactionManager {
    }

    +interface SecuritySetting <<blue>> {
        +setControlSamResource(samReader: <back:yellow>CardReader</back>, controlSam: LegacySam) -> SecuritySetting
    }
    +interface "<<<back:pink>CardTransactionCryptoExtension</back>>>\nCardTransactionLegacySamExtension" as CardTransactionLegacySamExtension {
        +prepareComputeSignature(data: SignatureComputationData<?>) -> CardTransactionLegacySamExtension
        +prepareVerifySignature(data: SignatureVerificationData<?>) -> CardTransactionLegacySamExtension
    }

    +interface "KeyPairContainer" as KeyPairContainer <<blue>> {
        +getKeyPair() -> byte array
    }
    +interface "LegacyCardCertificateComputationData" as LegacyCardCertificateComputationData <<blue>> {
        +setCardPublicKey(cardPublicKey: byte array) -> LegacyCardCertificateComputationData
        +setStartDate(startDate: date) -> LegacyCardCertificateComputationData
        +setEndDate(endDate: date) -> LegacyCardCertificateComputationData
        +setCardAid(aid: byte array) -> LegacyCardCertificateComputationData
        +setCardSerialNumber(serialNumber: byte array) -> LegacyCardCertificateComputationData
        +setCardStartupInfo(startupInfo: byte array) -> LegacyCardCertificateComputationData

        +getCertificate() -> byte array?
    }

    +interface "SignatureComputationData" as SignatureComputationData<T : SignatureComputationData<T>> <<grey>> {
        +setData(data: byte array, kif: byte, kvc: byte) -> T
        +setSignatureSize(size: integer) -> T
        +setKeyDiversifier(diversifier: byte array) -> T

        +getSignature() -> byte array
    }
    +interface BasicSignatureComputationData <<blue>> extends SignatureComputationData {
    }
    +interface TraceableSignatureComputationData <<blue>> extends SignatureComputationData {
        +withSamTraceabilityMode(offset: integer, samTraceabilityMode: SamTraceabilityMode) -> TraceableSignatureComputationData
        +withoutBusyMode() -> TraceableSignatureComputationData

        +getSignedData() -> byte array
    }
    +enum "SamTraceabilityMode" as SamTraceabilityMode <<green>> {
        FULL_SERIAL_NUMBER
        TRUNCATED_SERIAL_NUMBER
    }
    +interface "SignatureVerificationData" as SignatureVerificationData<T : SignatureVerificationData<T>> <<grey>> {
        +setData(data: byte array, signature: byte array, kif: byte, kvc: byte) -> T
        +setKeyDiversifier(diversifier: byte array) -> T

        +isSignatureValid() -> boolean
    }
    +interface BasicSignatureVerificationData <<blue>> extends SignatureVerificationData {
    }
    +interface TraceableSignatureVerificationData <<blue>> extends SignatureVerificationData {
        +withSamTraceabilityMode(offset: integer, samTraceabilityMode: SamTraceabilityMode, samRevocationService: LegacySamRevocationServiceSpi) -> TraceableSignatureVerificationData
        +withoutBusyMode() -> TraceableSignatureVerificationData
    }

    ' Exceptions
    +class "<<RuntimeException>>" as RuntimeException <<green>> {
        +**SamRevokedException**
        +**InconsistentDataException**: Number of R-APDUs != number of C-APDUs
        +**InvalidSignatureException**
    }
}
package "sam" as sam {
